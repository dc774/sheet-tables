{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sheet-tables/table",
	"title": "Sheet Table",
	"category": "widgets",
	"icon": "editor-table",
	"description": "Shows one of this site's sheet tables.",
	"keywords": [
		"spreadsheet",
		"google sheets",
		"csv"
	],
	"textdomain": "sheet-tables",
	"attributes": {
		"id": {
			"type": "integer",
			"default": 0
		},
		"layout": {
			"type": "string",
			"enum": [
				"table",
				"list"
			],
			"default": "table"
		},
		"headingLevel": {
			"type": "integer",
			"default": 3
		},
		"sticky": {
			"type": "boolean",
			"default": false
		},
		"columns": {
			"type": "object",
			"default": {}
		},
		"striped": {
			"type": "boolean",
			"default": false
		},
		"lines": {
			"type": "string",
			"enum": [
				"theme",
				"none",
				"rows",
				"all"
			],
			"default": "theme"
		},
		"padding": {
			"type": "string",
			"enum": [
				"theme",
				"compact",
				"roomy"
			],
			"default": "theme"
		},
		"narrow": {
			"type": "string",
			"enum": [
				"stack",
				"scroll"
			],
			"default": "stack"
		},
		"itemSpacing": {
			"type": "string",
			"enum": [
				"normal",
				"compact",
				"roomy"
			],
			"default": "normal"
		},
		"dividers": {
			"type": "boolean",
			"default": false
		},
		"labels": {
			"type": "string",
			"enum": [
				"beside",
				"above"
			],
			"default": "beside"
		},
		"detailSpacing": {
			"type": "string",
			"enum": [
				"normal",
				"compact"
			],
			"default": "normal"
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"text": true,
			"background": true,
			"link": true,
			"__experimentalSkipSerialization": [
				"text",
				"background"
			]
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true,
			"__experimentalSkipSerialization": true
		}
	},
	"editorScript": "file:./index.js",
	"style": "sheet-tables"
}
